{
    "name": "glusterfs-packaging",
    "version": "0.1.0",
    "description": "Reproducible GlusterFS package builds, signed repositories, runtime images, and release provenance.",
    "keywords": [
        "glusterfs",
        "rpm",
        "dnf",
        "centos",
        "repository",
        "packaging",
        "debian",
        "ubuntu",
        "containers",
        "provenance",
        "release-automation"
    ],
    "type": "module",
    "main": "scripts/conductor.mjs",
    "scripts": {
        "check": "npm run check:scripts",
        "check:scripts": "node scripts/check-syntax.mjs",
        "format": "prettier --write scripts tests containers package.json",
        "format:check": "prettier --check scripts tests containers package.json",
        "test": "eliware-test --ignore-100x4",
        "audit": "npm audit --omit=dev --audit-level=moderate --ignore-scripts",
        "lint": "eliware-test --lint",
        "verify:provenance": "node scripts/verify-provenance.mjs",
        "conductor": "node scripts/conductor.mjs"
    },
    "devDependencies": {
        "@eliware/test": "^2.3.1",
        "prettier": "^3.9.6",
        "puppeteer": "^25.8.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs",
            "**/?(*.)+(spec|test).cjs"
        ],
        "setupFiles": [
            "<rootDir>/tests/setup.mjs"
        ]
    },
    "engines": {
        "node": ">=26"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/eliware/glusterfs-packaging.git"
    },
    "author": "Eliware",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/glusterfs-packaging/issues"
    },
    "homepage": "https://github.com/eliware/glusterfs-packaging#readme",
    "packageManager": "npm@12.0.2",
    "private": true,
    "allowScripts": {
        "puppeteer@25.8.0": true,
        "unrs-resolver": false
    },
    "dependencies": {
        "@eliware/discord-webhook": "^1.1.8"
    }
}
