# Copy to an operator-managed environment file; never commit real values.
PUBLISH_ROOT=/mnt/pvc/gluster-repository-http
WORKSPACE_ROOT=/mnt/pvc/gluster-build-workspaces/conductor
REPOSITORY_BASE_URL=https://glusterfs.eliware.org
RPM_SIGNING_KEY=<key-id>
RPM_SIGNING_PASSPHRASE_FILE=/path/to/operator-managed/passphrase
DISCORD_WEBHOOK_URL=<operator-managed-secret>
CONTAINER_RUNTIME=docker
