[Unit]
Description=GlusterFS packaging conductor
ConditionPathIsDirectory=/eliware/glusterfs-packaging

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/gluster-packaging/release.env
Environment=CONDUCTOR_REPOSITORY_COMMIT_SCRIPT=/eliware/glusterfs-packaging/scripts/commit-publish-repository.mjs
ExecStart=/usr/bin/node /eliware/glusterfs-packaging/scripts/conductor-service.mjs
