# Shared EL10 x86_64 inputs. The watcher supplies the latest stable tag and
# version at runtime; rolling builds supply devel and their generated version.
TARGET_OS=el10
TARGET_ARCH=x86_64
BUILDER_IMAGE=ghcr.io/eliware/glusterfs-builder@sha256:7025d1997177d35f71540f3c8ed129b3267f29d196e5e24304acdf041b1fdabf
BUILDER_BASE_IMAGE=quay.io/centos/centos:stream10@sha256:b7f85bb8be4c471bc62842156a51bbf224b15243943733bd54e86ba5fd79b1fc
UPSTREAM_REPOSITORY=https://github.com/gluster/glusterfs.git
SELINUX_VERSION=2.0.1
SELINUX_TAG=v2.0.1
SELINUX_REPOSITORY=https://github.com/gluster/glusterfs-selinux.git
CONFIGURE_OPTIONS=--enable-gnfs
