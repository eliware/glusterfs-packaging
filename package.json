{
    "name": "glusterfs-packaging",
    "version": "0.1.0",
    "description": "Reproducible GlusterFS package builds, repository publishing, and release provenance.",
    "keywords": [
        "glusterfs",
        "rpm",
        "dnf",
        "centos",
        "repository",
        "packaging"
    ],
    "type": "module",
    "main": "scripts/conductor.mjs",
    "scripts": {
        "check": "npm run check:scripts",
        "check:scripts": "node scripts/check-syntax.mjs",
        "format": "prettier --write scripts tests containers package.json",
        "format:check": "prettier --check scripts tests containers package.json",
        "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --silent --runInBand --coverage",
        "audit": "npm audit --omit=dev --audit-level=moderate",
        "coverage": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --coverage --runInBand",
        "lint": "oxlint .",
        "test:gaps": "npm test 2>&1 | grep '|' | grep -vF '|     100 |      100 |     100 |     100 |'",
        "verify:provenance": "node scripts/verify-provenance.mjs",
        "conductor": "node scripts/conductor.mjs"
    },
    "devDependencies": {
        "jest": "^30.4.2",
        "oxlint": "^1.78.0",
        "prettier": "^3.9.6",
        "puppeteer": "^25.8.0"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs",
            "**/?(*.)+(spec|test).cjs"
        ],
        "setupFiles": ["<rootDir>/tests/setup.mjs"]
    },
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/eliware/glusterfs-packaging.git"
    },
    "author": "Eliware",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/glusterfs-packaging/issues"
    },
    "homepage": "https://github.com/eliware/glusterfs-packaging#readme",
    "packageManager": "npm@12.0.2",
    "private": true,
    "allowScripts": {
        "puppeteer@25.8.0": true,
        "unrs-resolver": false
    },
    "dependencies": {
        "@eliware/discord-webhook": "^1.1.8"
    }
}
